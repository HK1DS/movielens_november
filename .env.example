# Copy this file to .env and fill in your key(s). .env is git-ignored.
#
# Luxia API keys. Several keys may be listed; step1/step2 call the first 3 in parallel
# (IKGR_LLM_ACTIVE_KEYS, 0 = all), each with its own pacing. Keys after those (_4, _5, ...)
# are STANDBY: unused until an active key runs out of credit, then the next one takes its
# place. Empty lines are ignored. (ikgr_core/key_lanes.py; IKGR_LLM_KEY_MODE=sequential =
# one key at a time.)
# Any of these forms works, and they can be mixed:
#   LUXIA_API_KEY=key1                       (single key)
#   LUXIA_API_KEY_1=key2 / LUXIA_API_KEY_2=key3 / ...   (numbered, numeric order)
#   LUXIA_API_KEYS=key4,key5                 (comma separated)
LUXIA_API_KEY=
LUXIA_API_KEY_2=
LUXIA_API_KEY_3=
# standby keys: used only after one of the keys above is exhausted
LUXIA_API_KEY_4=
LUXIA_API_KEY_5=

GEMINI_API_KEY=
