# Copy this file to .env and fill in your key(s). .env is git-ignored.
#
# Luxia API keys. Several keys may be listed; they are used in this order and the
# next one takes over automatically when the current one runs out of credit
# (ikgr_core/key_pool.py). Any of these forms works, and they can be mixed:
#   LUXIA_API_KEY=key1                       (single key)
#   LUXIA_API_KEY_1=key2 / LUXIA_API_KEY_2=key3 / ...   (numbered, numeric order)
#   LUXIA_API_KEYS=key4,key5                 (comma separated)
LUXIA_API_KEY=
LUXIA_API_KEY_2=
LUXIA_API_KEY_3=

GEMINI_API_KEY=
