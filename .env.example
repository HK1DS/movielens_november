# Copy this file to .env and fill in your key(s). .env is git-ignored.
#
# Luxia API keys. Several keys may be listed; step1/step2 call all of them in parallel,
# each with its own pacing, and a key that runs out of credit drops out while the others
# carry on (ikgr_core/key_lanes.py; IKGR_LLM_KEY_MODE=sequential = one key at a time).
# Any of these forms works, and they can be mixed:
#   LUXIA_API_KEY=key1                       (single key)
#   LUXIA_API_KEY_1=key2 / LUXIA_API_KEY_2=key3 / ...   (numbered, numeric order)
#   LUXIA_API_KEYS=key4,key5                 (comma separated)
LUXIA_API_KEY=
LUXIA_API_KEY_2=
LUXIA_API_KEY_3=

GEMINI_API_KEY=
